PORT=5000

# Bookings use MongoDB transactions, which need a replica set.
# Atlas works out of the box; a local mongod must be started with --replSet.
MONGODB_URI=mongodb://localhost:27017/expert-booking?replicaSet=rs0

# CORS origin for browser clients only (native apps aren't subject to CORS). Use * to allow any.
CLIENT_URL=*

NODE_ENV=development

# Slot times ("10:00 AM") are interpreted in this timezone. Set it when hosting in UTC.
TZ=Asia/Kolkata
