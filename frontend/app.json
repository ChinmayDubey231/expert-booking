{
  "expo": {
    "name": "ExpertBook",
    "slug": "expert-booking-app",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#F3F5F4"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.expertbooking.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F6B5C"
      },
      "package": "com.expertbooking.app"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-font"
    ]
  }
}
